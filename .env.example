# Application
APP_NAME=ExamPilot Backend
APP_VERSION=1.0.0
DEBUG=false

# IMPORTANT: Replace with a strong random secret key in production.
# Generate one with: openssl rand -hex 32
SECRET_KEY=your-very-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=["https://yourfrontend.com","https://www.yourfrontend.com"]
# Use ["*"] for development only
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exampilot

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI-compatible)
# IMPORTANT: Set your actual API key here.
LLM_API_KEY=your-openai-api-key
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
